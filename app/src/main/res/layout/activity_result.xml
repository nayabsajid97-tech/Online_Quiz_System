<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink_background"
    android:padding="20dp">

    <TextView
        android:id="@+id/resultTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Results"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:id="@+id/singleResultLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/resultTitleTextView"
        android:visibility="gone"
        android:background="@drawable/button_bg"
        android:padding="20dp">

        <TextView
            android:id="@+id/quizNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz: "
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/studentNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student: "
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/scoreTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Score: "
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/percentageTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Percentage: "
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: "
            android:textSize="18sp"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/resultTitleTextView"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Dashboard"
        android:layout_alignParentBottom="true"
        android:background="@drawable/button_bg"
        android:textColor="@android:color/white"
        android:padding="15dp" />

</RelativeLayout>